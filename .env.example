# ---- Core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-with-64-random-characters
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,lms.local

# ---- Database / broker ----
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=lms
DATABASE_URL=postgres://lms:lms@postgres:5432/lms
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://lms:lms@rabbitmq:5672//

# ---- Web ----
PUBLIC_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
AUTH_COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---- Auth ----
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE=lms-otp
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Judge ----
JUDGE_SHARED_SECRET=replace-with-a-shared-secret
JUDGE_CALLBACK_URL=http://django:8000/internal/v1/judge/results

# ---- Storage (dev uses MinIO) ----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=lms
S3_SECRET_KEY=lms-secret
S3_BUCKET=lms
S3_REGION=default

# ---- Observability ----
LOG_LEVEL=INFO
GLITCHTIP_DSN=
